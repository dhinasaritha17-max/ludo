# LudoVerse Environment Configuration Example
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional External Database (defaults to persistent local database if omitted)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ludoverse

# Authentication Configurations
# Google OAuth Client ID for production Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Configuration (if using Firebase Auth)
FIREBASE_PROJECT_ID=ludoverse-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ludoverse-prod.iam.gserviceaccount.com
